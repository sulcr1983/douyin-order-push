# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 订单同步系统 - 配置文件
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 店铺列表（新增店铺只需在这里加名字，逗号分隔）
# 系统会自动读取 WECOM_WEBHOOK_URL_{店铺名大写} 作为该店铺的 Webhook
SHOP_NAMES=Qmaster,tianyixinxuan

# Qmaster 店铺
WECOM_WEBHOOK_URL_QMASTER=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=你的Qmaster店铺Webhook密钥

# 天颐心选店铺
WECOM_WEBHOOK_URL_TIANYIXINXUAN=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=你的天颐心选店铺Webhook密钥

# 数据库配置（统一存储，不用改）
UNIFIED_DB=orders.db

# 日志配置
LOG_FILE=sync_log.txt
LOG_LEVEL=INFO

# 订单过滤（逗号分隔，这些状态的订单不予同步）
EXCLUDE_ORDER_STATUSES=已关闭,已取消,未付款,待付款,交易关闭,取消订单

# 容错：连续失败次数超过此值则中断同步
MAX_CONSECUTIVE_FAILURES=10

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 企业微信字段映射
# 如果企业微信表格重新创建，字段 ID 变了，在这里改
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FIELD_SUB_ORDER_ID=fxNwEq
# FIELD_PRODUCT_ID=fCNsiv
# FIELD_PRODUCT_NAME=fBK7XT
# FIELD_QUANTITY=fy3AU0
# FIELD_MERCHANT_INCOME=ff2OiF
# FIELD_ORDER_STATUS=fJ0NdH
# FIELD_PAYMENT_TIME=fNuVBy
# FIELD_ADDRESS=fWJEK9
# FIELD_EXPRESS_INFO=fTMuqw
# FIELD_OUTBOUND_STATUS=fzFeek
